princ <- 100000
#How much money are you starting with
start_sal <- 8000
growth_sal <- 0.00
#Annual average growth rate of salary
#3% is normal
retire_contrib <- 1
#% of pre-tax salary contributed to 401k
retire_match_base <- .0
#% of pre-tax salary that employer will match for 401k
period_yr <- 30
#How many years to project balance for
SL <- 200000
age <- 28
base <- retirement_forecast(principal_investment = princ,
starting_salary = start_sal,
annual_salary_growth = growth_sal,
percent_salary_to_retirement = retire_contrib,
percent_employer_match = retire_match_base,
years_till_retirement = period_yr,
salary_limit = SL,
asset_mix = T,
age = age);base

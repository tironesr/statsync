years_till_retirement,
asset_mix = F,
age = F,
bond_limit = F,
salary_limit = F){
#Salary & Contributions
salary_range <- sapply(1:years_till_retirement, function(y){
starting_salary*(1+annual_salary_growth)^y
})
if(salary_limit != F){
replacement_index <- which(salary_range > salary_limit)
salary_range[replacement_index] <- salary_limit
}
monthly_contributions <- ((salary_range*percent_salary_to_retirement) + (salary_range*percent_employer_match))/12
if(asset_mix == F){
#Returns
sp_sim_returns <-lapply(1:100000,function(x){sample(Historic_SP,size = years_till_retirement, replace = T)})
#Identify average annual performance of each simulated set & save quantiles
sim_quantiles <- quantile(sapply(sp_sim_returns, mean),c(0.05,0.25,0.50,0.75,0.95), type = 1)}
#Generate DF with smoothed performance values
annual_return_df_smooth <- t(as.data.frame(sim_quantiles))
names(annual_return_df_smooth) <- c("5%","25%","50%","75%","95%")
monthly_return_df_smooth <- annual_return_df_smooth/12
balances_smooth <- sapply(c("5%","25%","50%","75%","95%"), function(w){
annual_balance <- vector()
if(w == "5%"){
return = monthly_return_df_smooth[1]
}
if(w == "25%"){
return = monthly_return_df_smooth[2]
}
if(w == "50%"){
return = monthly_return_df_smooth[3]
}
if(w == "75%"){
return = monthly_return_df_smooth[4]
}
if(w == "95%"){
return = monthly_return_df_smooth[5]
}
for (i in 1:years_till_retirement){
monthly_balances <-vector()
for (z in 1:12){
if(z == 1){
if(i == 1){
monthly_balances[z]<- principal_investment
}
if(i > 1){
monthly_balances[z] <- annual_balance[i-1]*(1+return) + monthly_contributions[i]
}
}
if(z > 1){
monthly_balances[z] <- monthly_balances[z-1]*(1+return) + monthly_contributions[i]
}
}
annual_balance[i] <- monthly_balances[12]
}
annual_balance
})
#Identify "ending balances" for $1,000 hypothetical investment
sim_thousand_balance <- sapply(sp_sim_returns, function(x){
end_balance <- vector()
for (i in 1:length(x)){
if(i == 1){
end_balance[i] <- 1000*(1+x[i])
}
if(i > 1){
end_balance[i] <- end_balance[i-1]*(1+x[i])
}
}
end_balance[length(x)]
})
if(asset_mix == T){
historic_perf <- cbind(Historic_Bond,Historic_SP)
#Create vector with % stock allocation over projection period
stock_percentage <- sapply(1:years_till_retirement, function(y){
(130 - (age + y-1))/100
})
#Cap stock percentage at 1.0 / 100%.
stock_percentage[which(stock_percentage > 1)] <- 1.0
bond_percentage <- 1-stock_percentage
#Returns
mixed_sim_returns <-lapply(1:100000,function(x){
index<- sample(1:nrow(historic_perf),size = years_till_retirement, replace = T)
historic_perf[index,]
})
weighted_mixed_sim_returns <- lapply(mixed_sim_returns, function(x){
weighted_returns <- x[,1]*bond_percentage + x[,2]*stock_percentage
})
sim_thousand_balance <- sapply(weighted_mixed_sim_returns, function(x){
end_balance <- vector()
for (i in 1:length(x)){
if(i == 1){
end_balance[i] <- 1000*(1+x[i])
}
if(i > 1){
end_balance[i] <- end_balance[i-1]*(1+x[i])
}
}
end_balance[length(x)]
})
}
#Add noise to avoid duplicates
noise <- seq(0,0.0000000002,0.000000000000001)
sim_thousand_balance <- sapply(1:length(sim_thousand_balance),function(x){
sim_thousand_balance[x] + noise[x]
})
#Calculate percentiles of annualized returns from each years_till_retirement sample
#Identify which samples (1:100000) represent each percentile
sim_thousand_quantile_values <- quantile(sim_thousand_balance,c(0.05,
0.25,
0.50,
0.75,
0.95), type = 1)
#Identify which samples (1:100000) represent each percentile
sim_thousand_quantile_index <- sapply(sim_thousand_quantile_values, function(y){
which(sim_thousand_balance == y)
})
if(asset_mix == F){
returns <- sp_sim_returns
}
if(asset_mix == T){
returns <- weighted_mixed_sim_returns
}
#For each percentile of interest, save annual performance data sim_thousand_quantile_index the sample
annual_return_df <- as.data.frame(do.call(cbind,returns[sim_thousand_quantile_index]))
names(annual_return_df) <- c("5%","25%","50%","75%","95%")
monthly_return_df <- annual_return_df/12
balances <- sapply(c("5%","25%","50%","75%","95%"), function(w){
annual_balance <- vector()
if(w == "5%"){
return = monthly_return_df[,1]
}
if(w == "25%"){
return = monthly_return_df[,2]
}
if(w == "50%"){
return = monthly_return_df[,3]
}
if(w == "75%"){
return = monthly_return_df[,4]
}
if(w == "95%"){
return = monthly_return_df[,5]
}
for (i in 1:years_till_retirement){
monthly_balances <-vector()
for (z in 1:12){
if(z == 1){
if(i == 1){
monthly_balances[z]<- principal_investment
}
if(i > 1){
monthly_balances[z] <- annual_balance[i-1]*(1+return[i]) + monthly_contributions[i]
}
}
if(z > 1){
monthly_balances[z] <- monthly_balances[z-1]*(1+return[i]) + monthly_contributions[i]
}
}
annual_balance[i] <- monthly_balances[12]
}
annual_balance
})
if (asset_mix == F){
output <- list("OReturn" = annual_return_df, "OBalances" = balances, "SReturn" = annual_return_df_smooth, "SBalances" = balances_smooth, "Salaries" = salary_range)}
if (asset_mix == T){
output <- list("Asset Mix Notes" = paste0("(1) Stock (vs. Bond) percentage is determined throughout the projection period by the following formula: 130-your age. (2) Asset Mix can only accurately be reflected in the 'Organic' projection. Smoothed projections do not account for the slow down in returns over time as stock concentration decreases. (3) If you capped the percentage of your assets that would be bonds using the 'bond_limit' argument, your % cap should appear next: ", bond_limit), "Asset Mix (Stock % | Bond % = 1-x)" = stock_percentage, "OReturn" = annual_return_df, "OBalances" = balances, "Salaries" = salary_range)}
return(output)
}
base <- retirement_forecast(principal_investment = princ,
starting_salary = start_sal,
annual_salary_growth = growth_sal,
percent_salary_to_retirement = retire_contrib,
percent_employer_match = retire_match_base,
years_till_retirement = period_yr,
salary_limit = SL,
asset_mix = T,
age = age);base
